generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  BRANCH_MANAGER
  STAFF
}

// A staff member / manager / master account who can log in and be
// credited on a bill.
model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bills               Bill[]
  passwordResetTokens PasswordResetToken[]
}

// Short-lived, single-use tokens for the "forgot password" flow.
// tokenHash stores a SHA-256 hash of the raw token — the raw token is
// only ever sent in the reset link, never persisted.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// One row per (role, permission key). MASTER is intentionally never
// stored here — it always has every permission, hardcoded, so it's
// impossible to lock the master account out of the app. Master's
// "Permissions" screen edits rows for BRANCH_MANAGER and STAFF only.
model RolePermission {
  id            Int     @id @default(autoincrement())
  role          Role
  permissionKey String
  granted       Boolean @default(false)

  @@unique([role, permissionKey])
}

// Singleton row (id is always 1) holding shop branding.
model Settings {
  id          Int     @id @default(1)
  companyName String  @default("My Shop")
  logoUrl     String?
}

model Product {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  category  String    @default("Uncategorized")
  price     Decimal   @db.Decimal(12, 2)
  unit      String    @default("pcs") // measuring type — e.g. pcs, kg, g, litre, ml, box, dozen
  qty       Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete — keeps old bills referencing this product intact

  billItems BillItem[]
}

model Bill {
  id           Int      @id @default(autoincrement())
  billNumber   String   @unique // e.g. "B-0001", assigned right after creation
  customerName String   @default("Walk-in Customer")
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  createdById Int?
  createdBy   User? @relation(fields: [createdById], references: [id])

  items BillItem[]
}

// Line items snapshot product name/price at the time of billing,
// so editing or deleting a product later never rewrites past bills.
model BillItem {
  id        Int     @id @default(autoincrement())
  billId    Int
  bill      Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Decimal @db.Decimal(12, 2)
  unit      String  @default("pcs")
  qty       Int
  amount    Decimal @db.Decimal(12, 2)
}
